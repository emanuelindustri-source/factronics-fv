{
  "name": "factronics-fv-ecosystem",
  "private": true,
  "version": "0.2.0",
  "description": "F&V (by Factronics) — monorepo: apps, esquema de contenido y packs. Sin secretos; contenido real fuera de git (ADR-0003).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate:content": "node packages/content-schema/src/cli.mjs validate packages/content-packs-demo",
    "migrate:content": "node packages/content-schema/src/cli.mjs migrate packages/content-packs-demo",
    "test": "npm test --workspace=@factronics-fv/content-schema --workspace=@factronics-fv/content-packs-demo"
  },
  "engines": {
    "node": ">=20"
  }
}
