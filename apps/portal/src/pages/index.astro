---
import fs from "node:fs";
import { fileURLToPath } from "node:url";

const progressPath = fileURLToPath(new URL("../../../../PROGRESS.json", import.meta.url));
const progress = JSON.parse(fs.readFileSync(progressPath, "utf8"));

const total = progress.phases.length;
const done = progress.phases.filter((p) => p.status === "completada").length;
const pct = Math.round((done / total) * 100);

const team = [
  { name: "Eduardo Rodríguez", role: "Supervisor Técnico" },
  { name: "Luis Iungano", role: "Técnico Especialista" },
  { name: "José Tovar", role: "Técnico Especialista" },
  { name: "José Gabriel Ríos", role: "Técnico Especialista" },
  { name: "Elián Inojosa", role: "Técnico Especialista" },
  { name: "Mariana Cerdeño", role: "Coordinadora de Servicio Técnico" }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>F&V (by Factronics) — Estudio y herramientas de campo</title>
    <meta
      name="description"
      content="F&V: aplicación interna de estudio, diagnóstico y herramientas de campo para el equipo técnico de Factronics, C.A. Android + PWA offline."
    />
    <meta property="og:title" content="F&V (by Factronics)" />
    <meta
      property="og:description"
      content="Aplicación interna de estudio, diagnóstico y herramientas de campo — Factronics, C.A."
    />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#10314F" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <style>
      :root {
        --navy: #10314f;
        --navy-deep: #0b2237;
        --amber: #f2a900;
        --bg: #f6f8fb;
        --surface: #ffffff;
        --text: #1a2733;
        --soft: #4a5b6a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.55;
      }
      main { max-width: 960px; margin: 0 auto; padding: 0 20px 64px; }
      header.hero {
        background: linear-gradient(135deg, var(--navy), var(--navy-deep));
        color: #fff;
        padding: 56px 20px 48px;
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      header.hero h1 { font-size: clamp(2.4rem, 6vw, 3.6rem); margin: 0; letter-spacing: 0.03em; }
      header.hero p { font-size: 1.15rem; opacity: 0.92; margin: 10px 0 0; }
      .logo-pulse { margin-bottom: 8px; }
      .badge {
        display: inline-block;
        background: var(--amber);
        color: var(--navy-deep);
        border-radius: 999px;
        padding: 6px 16px;
        font-weight: 700;
        margin-top: 18px;
        font-size: 0.9rem;
      }
      section { margin-top: 40px; }
      h2 { color: var(--navy); font-size: 1.6rem; border-bottom: 3px solid var(--amber); display: inline-block; padding-bottom: 4px; }
      .card {
        background: var(--surface);
        border-radius: 14px;
        padding: 20px 22px;
        box-shadow: 0 1px 4px rgba(16, 49, 79, 0.08);
        margin-top: 14px;
      }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
      .member { background: var(--surface); border-radius: 12px; padding: 14px 16px; box-shadow: 0 1px 3px rgba(16,49,79,.08); }
      .member b { display: block; color: var(--navy); }
      .member span { color: var(--soft); font-size: 0.9rem; }
      .tracker-row { display: flex; align-items: center; gap: 12px; padding: 8px 0; border-bottom: 1px solid rgba(16,49,79,.08); }
      .tracker-row:last-child { border-bottom: 0; }
      .status-pill { font-size: 0.78rem; font-weight: 700; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
      .completada { background: #d7f2dc; color: #1c5e26; }
      .curso { background: #ffe9b3; color: #7a5200; }
      .pendiente { background: #e4e9ee; color: #46586a; }
      .progress-bar { background: rgba(16,49,79,.12); border-radius: 999px; height: 14px; overflow: hidden; margin: 12px 0 4px; }
      .progress-fill { background: linear-gradient(90deg, var(--navy), var(--amber)); height: 100%; border-radius: 999px; }
      .btn {
        display: inline-block;
        background: var(--amber);
        color: var(--navy-deep);
        font-weight: 700;
        text-decoration: none;
        padding: 14px 26px;
        border-radius: 12px;
        min-height: 48px;
        margin: 6px 10px 6px 0;
      }
      .btn.secondary { background: var(--navy); color: #fff; }
      .disclaimer {
        background: rgba(242, 169, 0, 0.18);
        border-left: 5px solid var(--amber);
        padding: 14px 18px;
        border-radius: 10px;
        margin-top: 18px;
      }
      footer { background: var(--navy-deep); color: #cfdbe6; padding: 32px 20px; margin-top: 56px; text-align: center; }
      footer a { color: var(--amber); }
      .sources a { color: var(--navy); }
      @media (prefers-reduced-motion: no-preference) {
        .progress-fill { transition: width 0.6s ease; }
      }
    </style>
  </head>
  <body>
    <header class="hero">
      <svg class="logo-pulse" width="120" height="60" viewBox="0 0 120 60" aria-hidden="true">
        <path
          d="M4 34 H32 L42 12 L56 50 L66 34 H116"
          fill="none"
          stroke="#F2A900"
          stroke-width="7"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <h1>F&amp;V</h1>
      <p>by Factronics — Estudio, diagnóstico y herramientas de campo</p>
      <span class="badge">Fase 0 completada</span>
    </header>

    <main>
      <section>
        <h2>¿Qué es F&amp;V?</h2>
        <div class="card">
          <p>
            <strong>F&amp;V</strong> es la aplicación interna del equipo técnico de
            <strong>Factronics, C.A.</strong> para estudiar tecnologías de codificación e
            inspección (CIJ, TTO y Láser), practicar con exámenes, calcular consumo de
            insumos, consultar números de parte con su fuente y generar informes de campo.
          </p>
          <p>
            Disponible como <strong>app Android</strong> y <strong>PWA offline</strong>:
            funciona sin internet en planta y se actualiza cuando hay conexión.
          </p>
          <div class="disclaimer">
            <strong>Aviso:</strong> los certificados que emitirá la app son del
            <em>programa interno de competencias técnicas de Factronics, C.A.</em> No es una
            certificación oficial de Videojet Technologies.
          </div>
        </div>
      </section>

      <section>
        <h2>Descargas</h2>
        <div class="card">
          <a
            class="btn"
            href="https://github.com/emanuelindustri-source/factronics-fv/releases"
            >Descargar APK (Android)</a
          >
          <a class="btn secondary" href="https://github.com/emanuelindustri-source/factronics-fv"
            >Código fuente</a
          >
          <p style="color: var(--soft); font-size: 0.92rem">
            La PWA se instala desde el navegador (Añadir a pantalla de inicio). APK firmado
            y publicado por GitHub Releases con verificación SHA-256.
          </p>
        </div>
      </section>

      <section>
        <h2>Avance del proyecto</h2>
        <div class="card">
          <p style="margin: 0">
            <strong>{done} de {total} fases</strong> completadas — {pct}%
          </p>
          <div
            class="progress-bar"
            role="progressbar"
            aria-valuenow={pct}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-label="Progreso del proyecto"
          >
            <div class="progress-fill" style={`width:${pct}%`}></div>
          </div>
          <div style="margin-top: 10px">
            {
              progress.phases.map((p) => (
                <div class="tracker-row">
                  <span class={`status-pill ${p.status}`}>{p.status}</span>
                  <span>
                    <strong>{p.id}</strong> · {p.name}
                  </span>
                </div>
              ))
            }
          </div>
          <p style="color: var(--soft); font-size: 0.85rem">
            Actualizado: {progress.updated} · versión {progress.version}
          </p>
        </div>
      </section>

      <section>
        <h2>Historia (resumen con fuentes)</h2>
        <div class="card sources">
          <p>
            Factronics es un grupo líder en distribución de equipos industriales de fin de
            línea (EOL). <strong>Electrónica de Fábricas Factronics</strong> fue fundada en
            Venezuela en <strong>1986</strong>, y <strong>Factronics USA</strong> abrió sus
            puertas en <strong>2000</strong>. Con más de 35 años de experiencia, ofrece
            soluciones de codificación, inspección, empaquetado y automatización para las
            industrias de alimentos y bebidas, farmacéutica, médica y otras.
          </p>
          <p style="color: var(--soft); font-size: 0.9rem">
            Fuentes consultadas 25/11/2026:
            <a href="https://factronics.com.ve/nosotros/" rel="noopener" target="_blank"
              >factronics.com.ve/nosotros</a
            >
            y
            <a href="https://factronics.com.ve/" rel="noopener" target="_blank"
              >factronics.com.ve</a
            >.
            <a href="https://www.videojet.com/us/homepage.html" rel="noopener" target="_blank"
              >videojet.com</a
            > (tecnologías soportadas). Textos resumidos y citados; sin reproducción de
            material propietario.
          </p>
        </div>
      </section>

      <section>
        <h2>Equipo de validación técnica</h2>
        <div class="grid">
          {
            team.map((m) => (
              <div class="member">
                <b>{m.name}</b>
                <span>{m.role}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2>Privacidad y propiedad intelectual</h2>
        <div class="card">
          <p>
            La app no solicita permisos innecesarios: sin GPS por defecto, datos personales
            en el dispositivo, ranking opcional con alias. El contenido técnico real de
            Videojet/Factronics se publica únicamente con autorización escrita y fuente
            documentada; esta versión contiene <strong>solo contenido demo</strong>.
          </p>
        </div>
      </section>
    </main>

    <footer>
      <p>
        F&amp;V (by Factronics) · Factronics, C.A. — Caracas, Venezuela ·
        <a href="https://factronics.com.ve/" rel="noopener" target="_blank">factronics.com.ve</a>
      </p>
      <p style="font-size: 0.85rem">
        Programa interno de Factronics, C.A. No es una certificación oficial de Videojet
        Technologies.
      </p>
    </footer>
  </body>
</html>
