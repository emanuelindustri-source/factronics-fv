{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factronics-fv.github.io/schemas/content/1.0.0/familia.schema.json",
  "title": "F&V — Entidad: familia",
  "description": "Familia de equipos dentro de una tecnología.",
  "type": "object",
  "allOf": [{ "$ref": "base.schema.json#/$defs/itemBase" }],
  "properties": {
    "tipo": { "const": "familia" },
    "tecnologia_id": { "$ref": "base.schema.json#/$defs/refTec" },
    "nombre": { "type": "string", "minLength": 3, "maxLength": 120 },
    "descripcion": { "type": "string", "minLength": 10, "maxLength": 800 }
  },
  "required": ["tecnologia_id", "nombre"],
  "unevaluatedProperties": false
}
