{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factronics-fv.github.io/schemas/content/1.0.0/intento.schema.json",
  "title": "F&V — Entidad: intento",
  "description": "Registro de un intento de respuesta. Privacidad: solo alias, sin PII (AGENTS.md, regla 7).",
  "type": "object",
  "allOf": [{ "$ref": "base.schema.json#/$defs/itemBase" }],
  "properties": {
    "tipo": { "const": "intento" },
    "usuario_alias": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40,
      "description": "Alias del usuario. Prohibido almacenar nombre real, correo o identificadores personales."
    },
    "pregunta_id": { "$ref": "base.schema.json#/$defs/refQst" },
    "respuesta": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 600 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      ]
    },
    "correcta": { "type": "boolean" },
    "puntaje": { "type": "number", "minimum": 0, "maximum": 1 },
    "fecha": { "$ref": "base.schema.json#/$defs/fecha" },
    "nota": { "type": "string", "minLength": 3, "maxLength": 400 }
  },
  "required": ["usuario_alias", "pregunta_id", "respuesta", "correcta", "puntaje", "fecha"],
  "unevaluatedProperties": false
}
