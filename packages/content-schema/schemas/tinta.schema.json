{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factronics-fv.github.io/schemas/content/1.0.0/tinta.schema.json",
  "title": "F&V — Entidad: tinta (insumo)",
  "description": "Insumo de impresión (tinta, make-up, solvente, limpiador). En packs demo el código debe empezar por 'DEMO-'.",
  "type": "object",
  "allOf": [{ "$ref": "base.schema.json#/$defs/itemBase" }],
  "properties": {
    "tipo": { "const": "tinta" },
    "codigo": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._\\-/]*$"
    },
    "clase": {
      "type": "string",
      "enum": ["tinta", "make_up", "solvente", "limpiador", "otro"]
    },
    "color": { "type": "string", "minLength": 3, "maxLength": 60 },
    "descripcion": { "type": "string", "minLength": 10, "maxLength": 800 },
    "modelo_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "base.schema.json#/$defs/refMod" }
    }
  },
  "required": ["codigo", "clase", "descripcion"],
  "unevaluatedProperties": false
}
