{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factronics-fv.github.io/schemas/content/1.0.0/codigo_error.schema.json",
  "title": "F&V — Entidad: código de error",
  "description": "Código de error/falla con sugerencias de diagnóstico. PROHIBIDO inventar códigos reales: en packs demo el código debe empezar por 'DEMO-'.",
  "type": "object",
  "allOf": [{ "$ref": "base.schema.json#/$defs/itemBase" }],
  "properties": {
    "tipo": { "const": "codigo_error" },
    "codigo": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._\\-/]*$"
    },
    "titulo": { "type": "string", "minLength": 3, "maxLength": 200 },
    "descripcion": { "type": "string", "minLength": 10, "maxLength": 1200 },
    "causa_sugerida": { "type": "string", "minLength": 5, "maxLength": 800 },
    "accion_sugerida": { "type": "string", "minLength": 5, "maxLength": 800 },
    "modelo_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "base.schema.json#/$defs/refMod" }
    }
  },
  "required": ["codigo", "titulo", "descripcion"],
  "unevaluatedProperties": false
}
