{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factronics-fv.github.io/schemas/content/1.0.0/numero_parte.schema.json",
  "title": "F&V — Entidad: número de parte",
  "description": "Número de parte de un componente. PROHIBIDO inventar: solo códigos citados en la fuente. En packs demo, el código debe empezar por 'DEMO-'.",
  "type": "object",
  "allOf": [{ "$ref": "base.schema.json#/$defs/itemBase" }],
  "properties": {
    "tipo": { "const": "numero_parte" },
    "codigo": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._\\-/]*$"
    },
    "componente_id": { "$ref": "base.schema.json#/$defs/refCmp" },
    "descripcion": { "type": "string", "minLength": 3, "maxLength": 400 },
    "modelo_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "base.schema.json#/$defs/refMod" },
      "description": "Modelos donde se usa ('usado en')."
    }
  },
  "required": ["codigo", "componente_id", "descripcion", "modelo_ids"],
  "unevaluatedProperties": false
}
