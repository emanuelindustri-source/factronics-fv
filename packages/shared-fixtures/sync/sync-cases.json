    { "name": "clave de firma desconocida", "mutacion": "clave-desconocida", "expect": "reject", "codes_any": ["CLAVE-DESCONOCIDA"] },
    { "name": "bundle sin firma", "mutacion": "sin-firma", "expect": "reject", "codes_any": ["FIRMA-AUSENTE", "FIRMA-INVALIDA"] },
    { "name": "manifiesto sin campo obligatorio", "mutacion": "manifest-campo-faltante", "expect": "reject", "codes_any": ["MANIFIESTO-INVALIDO"] },
    { "name": "versión mínima de cliente no cumplida", "mutacion": "min-client-version", "expect": "reject", "codes_any": ["VERSION-CLIENTE"] },
    { "name": "schema_version futura se rechaza (nunca se adivina)", "mutacion": "version-futura", "expect": "reject", "codes_any": ["VERSION-FUTURA"] },
    { "name": "contract_version futura se rechaza", "mutacion": "contract-version-futura", "expect": "reject", "codes_any": ["CONTRATO-VERSION"] },
    { "name": "downgrade de pack se rechaza", "mutacion": "downgrade", "instalado_version": "2.0.0", "expect": "reject", "codes_any": ["DOWNGRADE"] },
