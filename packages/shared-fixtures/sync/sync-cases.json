  "delta_cases": [
    {
      "name": "delta válido: upsert + tombstone",
      "kind": "valido",
      "expect": "accept",
      "expect_version": "1.1.0",
      "expect_items": 2,
      "expect_tombstones": ["tec:demo-test"]
    },
    {
      "name": "idempotencia: aplicar dos veces el mismo delta deja el mismo estado",
      "kind": "idempotencia",
      "expect": "accept",
      "motivo_segunda": "ya-aplicado",
      "expect_version": "1.1.0"
    },
    {
      "name": "orden estricto: sequence fuera de orden se rechaza",
      "kind": "orden-invalido",
      "expect": "reject",
      "codes_any": ["ORDEN-INVALIDO"]
    },
    {
      "name": "base_version distinta de la instalada",
      "kind": "base-descuadre",
      "expect": "reject",
      "codes_any": ["BASE-DESCUADRE"]
    },
    {
      "name": "downgrade por delta se rechaza",
      "kind": "downgrade",
      "expect": "reject",
      "codes_any": ["DOWNGRADE"]
    },
    {
      "name": "tombstone es definitivo: la resurrección se rechaza",
      "kind": "tombstone-resurreccion",
      "expect": "reject",
      "codes_any": ["TOMBSTONE-CONFLICTO"]
    },
    {
      "name": "upsert con hash inválido",
      "kind": "hash-malo",
      "expect": "reject",
      "codes_any": ["HASH-INVALIDO"]
    },
    {
      "name": "delta que exige cliente más nuevo",
      "kind": "min-client",
      "expect": "reject",
      "codes_any": ["VERSION-CLIENTE"]
    },
    {
      "name": "cadena de deltas en orden converge (offline 24 h)",
      "kind": "cadena",
      "expect": "accept",
      "expect_version": "1.3.0",
      "expect_items": 2
    }
  ],
  "backup_cases": [
    { "name": "round-trip completo sobre almacenamiento limpio", "mutacion": "ninguna", "expect": "accept" },
    { "name": "backup con un bit alterado se rechaza", "mutacion": "checksum-alterado", "expect": "reject", "codes_any": ["RESPALDO-CORRUPTO"] },
    { "name": "formato de backup futuro", "mutacion": "formato-futuro", "expect": "reject", "codes_any": ["VERSION-FUTURA"] },
    { "name": "backup demasiado grande", "mutacion": "ninguna", "tamano_simulado": 52428801, "expect": "reject", "codes_any": ["RESPALDO-DEMASIADO-GRANDE"] },
    { "name": "backup con JSON corrupto", "mutacion": "json-invalido", "expect": "reject", "codes_any": ["RESPALDO-CORRUPTO"] },
    { "name": "backup con dato personal prohibido (privacidad)", "mutacion": "settings-con-nombre", "expect": "reject", "codes_any": ["RESPALDO-CORRUPTO", "MANIFIESTO-INVALIDO"] }
  ],
  "search_cases": [
