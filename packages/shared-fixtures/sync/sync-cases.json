  "bundle_cases": [
    { "name": "bundle válido (control)", "mutacion": "ninguna", "expect": "accept" },
    { "name": "ítem sin source_ref se rechaza (SIN FUENTE NO SE PUBLICA)", "mutacion": "item-sin-source-ref", "expect": "reject", "codes_any": ["CONTENIDO-INVALIDO"], "rules_any": ["FALTA-PROCEDENCIA"] },
    { "name": "source_ref incompleto se rechaza", "mutacion": "source-ref-incompleto", "expect": "reject", "codes_any": ["CONTENIDO-INVALIDO"], "rules_any": ["SOURCE-REF-INCOMPLETO"] },
