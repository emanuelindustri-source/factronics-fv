    { "name": "texto libre encuentra la pregunta", "query": { "texto": "sirve el mini-pack" }, "expect_ids": ["qst:demo-test-0001"] },
    { "name": "filtro por tipo", "query": { "tipo": "certificado" }, "expect_ids": ["crt:demo-test"] },
    { "name": "filtro por tecnología (índice)", "query": { "tecnologia": "tec:demo-test" }, "expect_ids": ["qst:demo-test-0001"] },
    { "name": "sin resultados devuelve lista vacía", "query": { "texto": "zzz-inexistente" }, "expect_ids": [] }
