    { "name": "certificado que se declara oficial de Videojet", "mutacion": "certificado-programa-oficial", "expect": "reject", "codes_any": ["CONTENIDO-INVALIDO"], "rules_any": ["CERTIFICADO-PROGRAMA"] },
